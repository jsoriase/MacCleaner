/* ---- why ---- */
"why.dataLoss" = "This is yours and there is no copy anywhere else: once deleted, it is gone.";
"why.recreate" = "You will have to create it again by hand, and its current state does not come back.";
"why.redownload" = "It has to be downloaded again the next time something needs it.";
"why.regenerates" = "It builds itself again next time it is needed, and you will not notice.";
"why.signOut" = "You will be signed out of the sites that use it and will have to log in again.";
"why.slowerBuild" = "Nothing is lost, but the next build will take longer while it is made again.";
"why.superseded" = "It’s an old version that nothing uses any more. If something asked for it again, it would be downloaded again.";
"why.toolDecides" = "The tool itself does the deleting, so exactly what disappears is up to it.";
"why.unknown" = "A catch-all: whatever no other row has named lands here. Look before deleting.";

